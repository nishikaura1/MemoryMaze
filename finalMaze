"""MemoryMaze: a maze game for memory-retention practice, controlled with ASL hand signs.

A webcam frame is classified by a CNN into one of four movement signs, and the sign
moves a sprite through the maze. Run with --keyboard to play with W/A/S/D instead.

Usage:
    python memory_maze.py                      # webcam + model
    python memory_maze.py --keyboard           # keyboard only, no model needed
    python memory_maze.py --threshold 0.8 --smooth 7 --camera 1
"""

from __future__ import annotations

import argparse
import sys
import time
from collections import Counter, deque
from dataclasses import dataclass
from pathlib import Path

import cv2
import numpy as np

HERE = Path(__file__).resolve().parent

# Model output index -> move. Matches the class order the model was trained with.
CLASS_TO_MOVE = {0: "left", 1: "right", 2: "back", 3: "forward"}
KEY_TO_MOVE = {ord("a"): "left", ord("d"): "right", ord("s"): "back", ord("w"): "forward"}

# (dx, dy) per move, in maze-image pixels (y grows downward).
MOVE_DELTA = {"left": (-1, 0), "right": (1, 0), "back": (0, -1), "forward": (0, 1)}

START = (82, 75)
FINISH_X = (725, 862)
FINISH_Y = (380, 415)

MAZE_SCALE = 0.5
SPRITE_SCALE = 0.4
WALL_THRESHOLD = 10      # grayscale value below which a maze pixel counts as wall
SPRITE_THRESHOLD = 95    # grayscale value above which a sprite pixel is foreground
INPUT_SIZE = 200


# ----------------------------------------------------------------------------
# Assets
# ----------------------------------------------------------------------------

def load_image(path: Path, scale: float = 1.0) -> np.ndarray:
    img = cv2.imread(str(path))
    if img is None:
        sys.exit(f"Missing or unreadable asset: {path}")
    if scale != 1.0:
        img = cv2.resize(img, (0, 0), fx=scale, fy=scale)
    return img


@dataclass
class Sprite:
    image: np.ndarray   # BGR, already scaled
    mask: np.ndarray    # bool, True where the sprite is drawn

    @classmethod
    def load(cls, path: Path) -> "Sprite":
        img = load_image(path, SPRITE_SCALE)
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        _, threshed = cv2.threshold(gray, SPRITE_THRESHOLD, 255, cv2.THRESH_BINARY)
        contours, _ = cv2.findContours(threshed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        mask = np.zeros(gray.shape, np.uint8)
        cv2.drawContours(mask, contours, -1, 255, thickness=-1)
        return cls(image=img, mask=mask.astype(bool))

    @property
    def size(self) -> tuple[int, int]:
        h, w = self.mask.shape
        return w, h


# ----------------------------------------------------------------------------
# Game state: collision and rendering
# ----------------------------------------------------------------------------

class Maze:
    def __init__(self, maze_img: np.ndarray, sprites: dict[str, Sprite], step: int):
        self.background = maze_img
        # Precompute the wall map once instead of re-thresholding on every move.
        gray = cv2.cvtColor(maze_img, cv2.COLOR_BGR2GRAY)
        self.walls = gray < WALL_THRESHOLD
        self.sprites = sprites
        self.step = step
        self.reset()

    def reset(self) -> None:
        self.x, self.y = START
        self.facing = "forward"

    def can_occupy(self, x: int, y: int, sprite: Sprite) -> bool:
        """True if the sprite fits at (x, y) inside the maze without touching a wall."""
        w, h = sprite.size
        H, W = self.walls.shape
        if x < 0 or y < 0 or x + w > W or y + h > H:
            return False
        return not self.walls[y:y + h, x:x + w].any()

    def move(self, direction: str) -> bool:
        """Turn to face `direction` and step if the path is clear. Returns True if moved."""
        self.facing = direction
        dx, dy = MOVE_DELTA[direction]
        nx, ny = self.x + dx * self.step, self.y + dy * self.step
        if self.can_occupy(nx, ny, self.sprites[direction]):
            self.x, self.y = nx, ny
            return True
        return False

    @property
    def finished(self) -> bool:
        return FINISH_X[0] <= self.x <= FINISH_X[1] and FINISH_Y[0] <= self.y <= FINISH_Y[1]

    def render(self) -> np.ndarray:
        frame = self.background.copy()
        sprite = self.sprites[self.facing]
        w, h = sprite.size
        roi = frame[self.y:self.y + h, self.x:self.x + w]
        roi[sprite.mask] = sprite.image[sprite.mask]
        return frame


# ----------------------------------------------------------------------------
# Sign recognition
# ----------------------------------------------------------------------------

class SignRecognizer:
    """Wraps the CNN with the preprocessing it expects, a confidence threshold and
    temporal smoothing, so one noisy frame can't move the player."""

    def __init__(self, model, threshold: float, smooth: int, rgb: bool = False):
        self.model = model
        self.threshold = threshold
        self.history: deque[str | None] = deque(maxlen=smooth)
        self.rgb = rgb

    def preprocess(self, frame: np.ndarray) -> np.ndarray:
        img = cv2.resize(frame, (INPUT_SIZE, INPUT_SIZE), interpolation=cv2.INTER_AREA)
        if self.rgb:
            img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        # Bug fix: the original normalized into `frame` but predicted on the raw pixels.
        return (img.astype(np.float32) / 255.0)[np.newaxis]

    def classify(self, frame: np.ndarray) -> tuple[str | None, float]:
        """Single-frame prediction. Returns (move or None, confidence)."""
        # Calling the model directly avoids model.predict()'s per-call overhead,
        # which dominates latency for a single frame.
        probs = np.asarray(self.model(self.preprocess(frame), training=False))[0]
        movement = probs[: len(CLASS_TO_MOVE)]
        idx = int(movement.argmax())
        conf = float(movement[idx])
        # Abstain when unsure rather than guessing a direction.
        return (CLASS_TO_MOVE[idx] if conf >= self.threshold else None), conf

    def update(self, frame: np.ndarray) -> tuple[str | None, float]:
        """Classify, then return a move only when it wins a majority of recent frames."""
        move, conf = self.classify(frame)
        self.history.append(move)
        if len(self.history) < self.history.maxlen:
            return None, conf
        winner, votes = Counter(self.history).most_common(1)[0]
        if winner is not None and votes > len(self.history) // 2:
            self.history.clear()  # one move per held sign
            return winner, conf
        return None, conf


def build_model(weights: Path):
    from tensorflow.keras import layers, models  # imported lazily: not needed for --keyboard

    model = models.Sequential([
        layers.Input(shape=(INPUT_SIZE, INPUT_SIZE, 3)),
        layers.Conv2D(32, 3, activation="relu", kernel_initializer="he_uniform", padding="same"),
        layers.Conv2D(32, 3, activation="relu", kernel_initializer="he_uniform", padding="same"),
        layers.MaxPooling2D(2),
        layers.Dropout(0.2),
        layers.Conv2D(64, 3, activation="relu", kernel_initializer="he_uniform", padding="same"),
        layers.Conv2D(64, 3, activation="relu", kernel_initializer="he_uniform", padding="same"),
        layers.MaxPooling2D(2),
        layers.Dropout(0.2),
        layers.Conv2D(128, 3, activation="relu", kernel_initializer="he_uniform", padding="same"),
        layers.Conv2D(128, 3, activation="relu", kernel_initializer="he_uniform", padding="same"),
        layers.MaxPooling2D(2),
        layers.Dropout(0.2),
        layers.Flatten(),
        layers.Dense(128, activation="relu", kernel_initializer="he_uniform"),
        layers.Dropout(0.2),
        layers.Dense(10, activation="softmax"),
    ])
    if not weights.exists():
        sys.exit(f"Model weights not found: {weights}")
    model.load_weights(str(weights))
    return model


# ----------------------------------------------------------------------------
# Main loop
# ----------------------------------------------------------------------------

def draw_hud(frame: np.ndarray, fps: float, move: str | None, conf: float) -> None:
    label = f"{fps:5.1f} FPS  |  {move or '-'}  ({conf:.2f})"
    cv2.putText(frame, label, (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)


def run(args: argparse.Namespace) -> None:
    assets = Path(args.assets)
    maze = Maze(
        load_image(assets / "Maze.png", MAZE_SCALE),
        {
            "left": Sprite.load(assets / "spriteLeft.png"),
            "right": Sprite.load(assets / "spriteRight.png"),
            "back": Sprite.load(assets / "spriteBackward.png"),  # fix: original checked collisions with spriteLeft
            "forward": Sprite.load(assets / "spriteForward.png"),
        },
        step=args.step,
    )
    start_screen = load_image(assets / "accMaze.png", MAZE_SCALE)
    finish_screen = load_image(assets / "finishScreen.png", MAZE_SCALE)

    cv2.imshow("MemoryMaze", start_screen)
    cv2.waitKey(0)

    recognizer = cam = None
    if not args.keyboard:
        recognizer = SignRecognizer(build_model(Path(args.weights)), args.threshold, args.smooth, args.rgb)
        cam = cv2.VideoCapture(args.camera)
        if not cam.isOpened():
            sys.exit(f"Could not open camera {args.camera}")

    fps, last = 0.0, time.perf_counter()
    try:
        while True:
            move, conf = None, 0.0
            if cam is not None:
                ok, frame = cam.read()
                if not ok:
                    break
                move, conf = recognizer.update(frame)
                now = time.perf_counter()
                fps = 0.9 * fps + 0.1 * (1.0 / max(now - last, 1e-6))  # smoothed FPS
                last = now
                draw_hud(frame, fps, move, conf)
                cv2.imshow("Camera", frame)

            # One waitKey per loop. The original called waitKey(33) inside every redraw
            # and collision check, adding ~100 ms of sleep per frame.
            key = cv2.waitKey(1) & 0xFF
            if key in (ord("q"), 27, ord(" ")):  # q, Esc or Space quits
                break
            if key == ord("r"):
                maze.reset()
            move = move or KEY_TO_MOVE.get(key)  # keyboard always works as a fallback

            if move:
                maze.move(move)
            cv2.imshow("MemoryMaze", finish_screen if maze.finished else maze.render())
    finally:
        if cam is not None:
            cam.release()
        cv2.destroyAllWindows()


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--assets", default=str(HERE / "assets"), help="folder with the maze and sprite images")
    p.add_argument("--weights", default=str(HERE / "weights.hdf5"), help="trained model weights")
    p.add_argument("--camera", type=int, default=0, help="webcam index")
    p.add_argument("--keyboard", action="store_true", help="play with W/A/S/D, no camera or model")
    p.add_argument("--threshold", type=float, default=0.7, help="minimum confidence to accept a sign")
    p.add_argument("--smooth", type=int, default=5, help="frames a sign must win before it counts")
    p.add_argument("--step", type=int, default=7, help="pixels moved per sign")
    p.add_argument("--rgb", action="store_true", help="convert frames to RGB if the model was trained on RGB")
    return p.parse_args(argv)


if __name__ == "__main__":
    run(parse_args())
