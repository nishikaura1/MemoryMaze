"""Measure the sign recognizer's accuracy and latency on a held-out image set.

Expects one folder per class, named after the move it controls:

    test_data/
        left/     *.jpg|*.png
        right/
        back/
        forward/

Usage:
    python evaluate.py test_data --weights weights.hdf5
"""

from __future__ import annotations

import argparse
import json
import time
from pathlib import Path

import cv2
import numpy as np

from memory_maze import CLASS_TO_MOVE, SignRecognizer, build_model

MOVE_TO_CLASS = {m: i for i, m in CLASS_TO_MOVE.items()}
IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".bmp"}


def evaluate(recognizer: SignRecognizer, data_dir: Path) -> dict:
    n = len(CLASS_TO_MOVE)
    confusion = np.zeros((n, n), dtype=int)      # rows: true, cols: predicted
    abstained = np.zeros(n, dtype=int)
    latencies_ms: list[float] = []

    for move, true_idx in MOVE_TO_CLASS.items():
        for path in sorted((data_dir / move).glob("*")):
            if path.suffix.lower() not in IMAGE_EXTS:
                continue
            img = cv2.imread(str(path))
            if img is None:
                continue
            t0 = time.perf_counter()
            pred, _ = recognizer.classify(img)
            latencies_ms.append((time.perf_counter() - t0) * 1000)
            if pred is None:
                abstained[true_idx] += 1
            else:
                confusion[true_idx, MOVE_TO_CLASS[pred]] += 1

    total = int(confusion.sum() + abstained.sum())
    answered = int(confusion.sum())
    correct = int(np.trace(confusion))
    lat = np.array(latencies_ms[1:] or latencies_ms)  # drop the first call (graph warm-up)
    return {
        "images": total,
        "accuracy_overall": round(correct / total, 4) if total else None,
        "accuracy_when_answered": round(correct / answered, 4) if answered else None,
        "abstention_rate": round(int(abstained.sum()) / total, 4) if total else None,
        "per_class_accuracy": {
            CLASS_TO_MOVE[i]: round(confusion[i, i] / max(confusion[i].sum() + abstained[i], 1), 4)
            for i in range(n)
        },
        "confusion_matrix": {"labels": [CLASS_TO_MOVE[i] for i in range(n)], "rows_true_cols_pred": confusion.tolist()},
        "latency_ms": {
            "mean": round(float(lat.mean()), 2) if lat.size else None,
            "p95": round(float(np.percentile(lat, 95)), 2) if lat.size else None,
        },
        "max_fps_model_only": round(1000 / float(lat.mean()), 1) if lat.size else None,
    }


def main() -> None:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("data_dir", type=Path)
    p.add_argument("--weights", type=Path, default=Path("weights.hdf5"))
    p.add_argument("--threshold", type=float, default=0.0,
                   help="confidence threshold; 0 measures raw accuracy with no abstention")
    p.add_argument("--rgb", action="store_true")
    args = p.parse_args()

    recognizer = SignRecognizer(build_model(args.weights), args.threshold, smooth=1, rgb=args.rgb)
    print(json.dumps(evaluate(recognizer, args.data_dir), indent=2))


if __name__ == "__main__":
    main()
